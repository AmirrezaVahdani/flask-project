# Example environment variables for Raspberry Pi and LED testing
# Number of lockers
LOCKER_COUNT=3

# Hardware mode: mock | command | gpio
LOCKER_HARDWARE_MODE=gpio

# Duration (seconds) to keep locker open (LED on)
LOCKER_OPEN_DURATION_SECONDS=30

# GPIO pin map: locker_number:BCM_pin, separated by commas
# Example: locker 1 -> GPIO17, locker 2 -> GPIO27
LOCKER_HARDWARE_GPIO_PIN_MAP="1:17,2:27,3:22"

# Default single-pin open/close pins (optional)
LOCKER_HARDWARE_GPIO_OPEN_PIN=17
LOCKER_HARDWARE_GPIO_CLOSE_PIN=27

# Active state for GPIO when 'open' (1 or 0)
LOCKER_HARDWARE_GPIO_ACTIVE_STATE=1

# Database and flask settings (optional overrides)
#FLASK_DEBUG=0
#SECRET_KEY=your_secret_here
